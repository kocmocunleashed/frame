{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": false },
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.ts": {
      "maxDuration": 300,
      "includeFiles": "{drizzle/**,server/browser-driver.mjs,server/extract-worker.ts,src/slide.css,src/portable.ts,node_modules/@fontsource*/**/*,node_modules/@sparticuz/chromium/bin/**}"
    },
    "api/worker.ts": {
      "maxDuration": 300,
      "includeFiles": "{drizzle/**,server/browser-driver.mjs,server/extract-worker.ts,src/slide.css,src/portable.ts,node_modules/@fontsource*/**/*,node_modules/@sparticuz/chromium/bin/**}",
      "experimentalTriggers": [
        { "type": "queue/v2beta", "topic": "frame-jobs" }
      ]
    },
    "api/sweep.ts": { "maxDuration": 60 },
    "api/studio.ts": { "maxDuration": 10, "includeFiles": "dist/index.html" }
  },
  "routes": [
    { "src": "/api/sweep", "dest": "/api/sweep" },
    { "src": "/api/worker", "dest": "/api/worker" },
    { "src": "/api/studio", "dest": "/api/studio" },
    { "src": "/api/(.*)", "dest": "/api/server" },
    { "src": "/(?:index\\.html)?", "dest": "/api/studio" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/studio" }
  ],
  "crons": [{ "path": "/api/sweep", "schedule": "0 0 * * *" }]
}
