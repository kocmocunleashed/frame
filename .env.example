NODE_ENV=development
PORT=3158
APP_ORIGIN=http://127.0.0.1:5174
# Neon PostgreSQL URL. Credentials stay on the server. TLS is required in production.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_ENDPOINT.neon.tech/frame?sslmode=verify-full
# At least 32 random characters. Generate once; keep stable across API instances.
BETTER_AUTH_SECRET=
# Local adapters must be explicitly selected. Production uses S3/SQS.
FRAME_STORAGE=local
FRAME_ASSETS=.frame-data/assets
FRAME_EXPORTS=.frame-data/exports
FRAME_STAGING=.frame-data/staging
FRAME_QUEUE_DRIVER=local
# Optional Vercel hosting uses FRAME_STORAGE=blob and FRAME_QUEUE_DRIVER=vercel.
# Keep private Blob and cron credentials on the server; local/ECS modes do not need them.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
FRAME_JOB_TIMEOUT_MS=270000
# Used only by the optional local Docker Compose PostgreSQL service.
FRAME_POSTGRES_PASSWORD=
AWS_REGION=
FRAME_S3_BUCKET=
FRAME_S3_REGION=
FRAME_SQS_QUEUE_URL=
FRAME_SQS_DLQ_URL=
FRAME_ADMIN_USER_IDS=
FRAME_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Existing pinned options; no model fallback.
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
OPENROUTER_MUSE_CONTRIBUTOR_ENABLED=true
# Optional alternatives when FRAME_AI_PROVIDER=openai or tokenrouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=
TOKENROUTER_BASE_URL=
FRAME_CHROME_PATH=
FRAME_NODE_PATH=
# Independent backup encryption key: 32 random bytes, hexadecimal.
FRAME_BACKUP_KEY=
# Optional social sign-in; configure both values for each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional verified sender for verification and password recovery emails.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
