NODE_ENV=development
PORT=3158
APP_ORIGIN=http://127.0.0.1:5174
MONGODB_URI=mongodb://127.0.0.1:27017/frame_dev?replicaSet=rs0
MONGODB_DATABASE=frame_dev
# Local adapters must be explicitly selected. Production rejects them.
FRAME_STORAGE=local
FRAME_ASSETS=.frame-data/assets
FRAME_EXPORTS=.frame-data/exports
FRAME_STAGING=.frame-data/staging
FRAME_QUEUE_DRIVER=local
FRAME_JOB_TIMEOUT_MS=270000
# Set these for S3/SQS deployment; SDK credentials come from task IAM roles.
AWS_REGION=
FRAME_S3_BUCKET=
FRAME_S3_REGION=
FRAME_SQS_QUEUE_URL=
FRAME_SQS_DLQ_URL=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5174
FRAME_ADMIN_USER_IDS=
FRAME_AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Pinned paid options: meta/muse-spark-1.3-contributor or google/gemma-4-31b-it.
# Gemma 4 ceilings: $0.20/M input, $0.40/M output; no model fallback.
OPENROUTER_MODEL=meta/muse-spark-1.3-contributor
# Required for Muse Contributor only; set false when selecting Gemma 4.
OPENROUTER_MUSE_CONTRIBUTOR_ENABLED=true
FRAME_CHROME_PATH=
FRAME_NODE_PATH=
# Erxes mode: configure all three, and omit browser Clerk configuration.
FRAME_ERXES_ORIGIN=
FRAME_ERXES_TENANT=
FRAME_ERXES_SECRET=
# Independent backup encryption key: 32 random bytes, hexadecimal.
FRAME_BACKUP_KEY=
