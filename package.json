{
  "name": "frame-aws",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "setup": "bun --no-env-file scripts/setup.ts",
    "dev": "bun scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun --no-env-file scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "bun --no-env-file scripts/test.ts --browser",
    "test:visual": "bun --no-env-file scripts/test.ts --browser e2e/slides.visual.spec.ts",
    "test:visual:update": "bun --no-env-file scripts/test.ts --browser e2e/slides.visual.spec.ts --update-snapshots",
    "format": "prettier --write src shared server tests e2e *.ts *.json *.html *.md docs/*.md",
    "dev:api": "bun --watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:browser-test": "concurrently --kill-others -n api,web \"bun e2e/server.ts\" \"bun run dev:web\"",
    "check:ai": "bun scripts/check-ai.ts",
    "check:openrouter": "bun scripts/check-openrouter.ts",
    "ops": "bun scripts/operations.ts",
    "check:storage": "bun scripts/check-storage.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "erxes:build": "bun run --cwd frame-erxes build",
    "erxes:test": "bun run --cwd frame-erxes test",
    "erxes:test:browser": "bun --no-env-file scripts/test.ts --erxes",
    "erxes:preview": "bun --no-env-file scripts/test.ts --erxes --serve",
    "erxes:install": "bun frame-erxes/scripts/install.ts",
    "worker": "bun server/workers/worker.ts",
    "dispatcher": "bun server/workers/dispatcher.ts",
    "maintenance": "bun server/workers/maintenance.ts",
    "dev:fixture": "bun scripts/fixture.ts",
    "infra:check": "bun infra/check.ts",
    "infra:synth": "cd infra && bunx cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vitejs/plugin-react": "^6.1.2",
    "embla-carousel-react": "8.6.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^1.58.0",
    "mammoth": "^1.13.0",
    "mongodb": "6.21.0",
    "openai": "^7.34.0",
    "pdfjs-dist": "^6.4.299",
    "playwright": "^1.64.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-rnd": "^10.5.3",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/whatwg-url": "11.0.5",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.220.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "constructs": "10.8.1",
    "happy-dom": "^21.0.3",
    "mongodb-memory-server": "11.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "whatwg-url": "14.2.0"
  },
  "overrides": {
    "whatwg-url": "14.2.0",
    "@types/whatwg-url": "11.0.5",
    "@types/webidl-conversions": "7.0.3"
  }
}
